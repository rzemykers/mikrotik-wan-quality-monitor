# wanqm/secrets.local - SECRETS. Copy this file to `secrets.local` and fill it in.
# This is the ONLY place where wanqm tokens are kept.
#
# build_install.py substitutes these values for the __NAME__ placeholders in the *.body
# files, so the sources stay clean and can be shared safely.
# NOTE: the generated wanqm-install-*.rsc DO contain the real tokens (they have to - they
# go onto the router), so treat them as secrets: they are gitignored, and the build sets
# them to chmod 600.
#
# Rotation: change the token in your webhook backend AND here, then re-run
# `python3 build_install.py all` and re-import on the routers.

# Shared secret sent as the X-Auth-Token header to the /notify webhook (Telegram).
NOTIFY_TOKEN=change-me

# Shared secret sent as the X-Auth-Token header to the /sms-send webhook.
SMS_TOKEN=change-me

# SMS recipient in E.164 format (+48...). While this is literally __UNSET__, the SMS
# channel is safely SKIPPED (wanqm-notify checks for that sentinel) and Telegram still works.
SMS_TO=__UNSET__
